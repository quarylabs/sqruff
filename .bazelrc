# Build with optimizations
build --compilation_mode=opt

# Release packaging is opt-in locally; CI includes it in the same test command.
# Both filters are needed to exclude packaging tests and non-test build targets.
# Custom tag filters replace these defaults; retain -ci-only for local runs.
build --build_tag_filters=-ci-only
test --test_tag_filters=-ci-only

# Let dependent Rust libraries compile before their dependencies finish codegen.
# Opt in for dependency-heavy incremental builds with --config=pipelined.
build:pipelined --@rules_rust//rust/settings:pipelined_compilation=true

# Use remote cache for CI (can be configured per-environment)
# build --remote_cache=...

# Improve build output
build --show_progress_rate_limit=0.5
build --curses=yes

# Test output
test --test_output=errors

# Lint aspects from aspect_rules_lint, declared in //:linters.bzl.
# `bazel build --config=lint //...` reports violations and fails the build;
# `bazel test //:keep_sorted_check` is the same check wired as a test.
build:lint --aspects=//:linters.bzl%keep_sorted
build:lint --output_groups=rules_lint_human
build:lint --@aspect_rules_lint//lint:fail_on_violation

# CI-specific settings
common:ci --lockfile_mode=error
build:ci --build_tag_filters=
test:ci --test_tag_filters=
build:ci --color=yes
build:ci --curses=no
build:ci --show_timestamps
build:ci --verbose_failures

# CI test output settings - show errors only but with detailed summary
test:ci --test_output=errors
test:ci --test_summary=detailed
test:ci --verbose_failures

# Fail fast - stop on first test failure
test:ci --nokeep_going
