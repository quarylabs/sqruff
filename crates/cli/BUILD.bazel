load("//:compiler.bzl", "compiler_targets")
load("//:clippy.bzl", "cargo_lints", "clippy_config")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_test", "rust_binary", "rust_test_suite")

exports_files(["Cargo.toml"])

# Cargo --all-features, including implicit optional-dependency features.
_CLIPPY_FEATURES = [
    "bench",
    "codegen-docs",
    "default",
    "dhat-heap",
    "mimalloc",
    "parser",
    "pyo3",
    "python",
]

rust_binary(
    name = "sqruff",
    lint_config = ":cargo_lints",
    crate_features = clippy_config([], _CLIPPY_FEATURES),
    srcs = ["src/main.rs"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + clippy_config([], ["@crates//:dhat"]) + [
        "//crates/cli-lib:sqruff-cli-lib",
    ],
)

# The benchmark consumes a prebuilt CLI; it never invokes Cargo itself.
rust_binary(
    name = "bench",
    lint_config = ":cargo_lints",
    crate_features = clippy_config([], _CLIPPY_FEATURES),
    srcs = ["src/bin/bench.rs"],
    visibility = ["//visibility:public"],
)

# Cargo and Bazel both discover the integration tests from tests/*.rs.
rust_test_suite(
    name = "cli_tests",
    lint_config = ":cargo_lints",
    crate_features = clippy_config([], _CLIPPY_FEATURES),
    srcs = glob(["tests/*.rs"]),
    shared_srcs = glob(["tests/common/**/*.rs"]),
    data = [
        ":sqruff",
        ":test_fixtures",
        "Cargo.toml",
    ],
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/lib:sqruff-lib",
    ],
    env = {
        "SQRUFF_BIN": "$(rootpath :sqruff)",
        "SQRUFF_TEST_MANIFEST": "$(rootpath :Cargo.toml)",
    },
    size = "small",
)

# Binary with codegen-docs feature for generating documentation
rust_binary(
    name = "sqruff-codegen",
    lint_config = ":cargo_lints",
    srcs = ["src/main.rs"],
    crate_features = ["codegen-docs"],
    data = ["//crates/cli-lib:codegen_templates"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        "//crates/cli-lib:sqruff-cli-lib-codegen",
    ],
)

filegroup(
    name = "machete_srcs",
    srcs = glob(
        [
            "src/**/*.rs",
            "tests/**/*.rs",
            "benches/**/*.rs",
        ],
        allow_empty = True,
    ) + ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "test_fixtures",
    srcs = glob(["tests/**"]),
    visibility = ["//visibility:public"],
)

# Keep Rust and Clippy lint levels inherited from Cargo.toml.
cargo_lints()

rust_test(
    name = "sqruff-compile-test",
    lint_config = ":cargo_lints",
    crate = ":sqruff",
    crate_features = clippy_config([], _CLIPPY_FEATURES),
    tags = ["manual"],
)

rust_test(
    name = "bench-compile-test",
    lint_config = ":cargo_lints",
    crate = ":bench",
    crate_features = clippy_config([], _CLIPPY_FEATURES),
    tags = ["manual"],
)

compiler_targets(libraries = [":sqruff", ":bench"])
